# provenance=true here rather than as NPM_CONFIG_PROVENANCE in the release
# workflow. The environment variable is an npm-CLI convention that pnpm does not
# honour: v0.1.0 published with it set and attached no attestations at all.
# pnpm does read .npmrc, so this is the route that actually takes effect.
#
# Consequence worth knowing: `pnpm publish` from a laptop will now fail, because
# provenance requires a CI OIDC context. That is intended. Releases run from
# .github/workflows/release.yml — see .changeset/README.md.
provenance=true
