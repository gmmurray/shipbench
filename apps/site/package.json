{
  "name": "@shipbench/site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist/client",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json --output human",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/intel-one-mono": "^5.2.2",
    "astro": "^7.0.6",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
