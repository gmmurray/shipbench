---
// Inline SVG <symbol> definitions for the doctrine's two structural primitives.
// Mounted once in BaseLayout. Harbor keeps its own copy in its own repository,
// identical in shape to this one — the two apps share the doctrine, not a
// package.
//
// #logo — the brand mark for in-page brand slots. Transparent and theme-aware:
// its fills read the `silver`/`frosted` tokens, so the mark inverts with the
// theme instead of sitting in a dark badge on light. Only possible inline — an
// <img src="/logo.svg"> is an isolated document and inherits nothing from the
// page. public/logo.svg and the raster icon set are generated from
// docs/brand/logo-mark.svg by `pnpm generate:icons`; this symbol is its
// theme-token form for page contexts. The token names differ from Harbor's copy
// (`--silver` here, `--color-silver` there) because the two apps expose the
// palette differently.
// #chev — the pointing/gauge primitive. Currently unreferenced on this site
// (the drawer toggles that used it moved to #disc), kept deliberately: it is a
// doctrine primitive, the site is one breadcrumb away from needing it, and a
// re-derived copy is how these drift apart.
// #disc — the disclosure marker: `+` by default, `−` when the consumer sets
// `--sb-disc-cross: transparent`. Sized for a 10px box so its 1px bars land on
// whole pixels.
---

<svg width="0" height="0" style="display:none; position:absolute;" aria-hidden="true">
  <defs>
    <clipPath id="sb-sail-mid">
      <path d="M 449 298.585938 L 934 298.585938 L 934 960 L 449 960 Z"></path>
    </clipPath>
    <clipPath id="sb-hull">
      <path d="M 269 896 L 1305 896 L 1305 1201.585938 L 269 1201.585938 Z"></path>
    </clipPath>
    <symbol id="logo" viewBox="195 298.585938 1110 903">
      <path fill="var(--frosted)" fill-rule="evenodd" d="M 1226.8125 802.757812 C 1152.554688 787.125 1070.480469 822.300781 988.40625 904.375 C 1011.855469 724.59375 961.046875 564.351562 832.074219 415.835938 C 1058.757812 451.007812 1191.640625 579.984375 1226.8125 802.757812 Z M 1226.8125 802.757812 "></path>
      <g clip-path="url(#sb-sail-mid)">
        <path fill="var(--silver)" fill-rule="evenodd" d="M 933.6875 822.300781 C 839.890625 802.757812 742.179688 845.75 640.566406 959.09375 C 667.921875 716.777344 605.390625 497.910156 449.054688 298.585938 C 726.546875 345.484375 890.699219 521.359375 929.78125 822.300781 Z M 933.6875 822.300781 "></path>
      </g>
      <path fill="var(--frosted)" fill-rule="evenodd" d="M 589.757812 802.757812 C 515.5 787.125 433.421875 822.300781 351.347656 904.375 C 374.796875 724.59375 323.988281 564.351562 195.015625 415.835938 C 421.699219 451.007812 554.582031 579.984375 589.757812 802.757812 Z M 589.757812 802.757812 "></path>
      <g clip-path="url(#sb-hull)">
        <path fill="var(--silver)" fill-rule="evenodd" d="M 339.625 1181.867188 C 335.714844 1134.96875 312.265625 1095.882812 269.273438 1064.617188 C 503.773438 1080.25 707.007812 1060.707031 875.066406 1002.085938 C 1090.023438 931.734375 1230.722656 896.558594 1304.980469 896.558594 C 1183.824219 951.277344 1097.839844 1033.351562 1043.121094 1142.785156 C 800.804688 1205.316406 566.304688 1220.949219 339.625 1181.867188 Z M 339.625 1181.867188 "></path>
      </g>
    </symbol>
    <symbol id="chev" viewBox="0 0 24 24">
      <path fill="currentColor" d="M3 2.5 L15 12 L3 21.5 L8.6 21.5 L20.6 12 L8.6 2.5 Z"></path>
    </symbol>
    <symbol id="disc" viewBox="0 0 10 10">
      <path fill="currentColor" d="M1 4.5 h8 v1 h-8 Z"></path>
      <path fill="var(--sb-disc-cross, currentColor)" d="M4.5 1 h1 v8 h-1 Z"></path>
    </symbol>
  </defs>
</svg>
