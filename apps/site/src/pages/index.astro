---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroWorkspaceWindow from '../components/HeroWorkspaceWindow.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { SITE_CONFIG } from '../config/site';

const quickstartSnippet = [
  { comment: true, text: '# 1. Initialize ShipBench' },
  { prompt: '›', text: 'npx shipbench init' },
  {},
  { comment: true, text: '# 2. Create the first task' },
  { prompt: '›', text: 'npx shipbench task create "Build landing page" --priority=high' },
  {},
  { comment: true, text: '# 3. Open the local board' },
  { prompt: '›', text: 'npx shipbench board' },
];

/* The three trace specimens follow one task — `build-core-fsadapter`, the card
   the hero board shows in progress — from selection, to a recorded decision, to
   the search that finds it again. They are specimens, not instructions: every
   line names a slug the reader does not have, so none of them copies. The
   output is the CLI's real output, down to the `[live · done]` location tag
   and the `↳ update 0` line, which the CLI prints unwrapped. The entry is kept
   short enough that the whole line fits the desktop column without the
   snippet truncating; narrower screens scroll it rather than rewrap it. `task
   search` gained Task Updates coverage and relevance ranking before this page
   claimed any of it. */
const traceSelectSnippet = [
  { prompt: '›', text: 'shipbench task list --available' },
  { comment: true, text: '[todo] Build core FsAdapter (build-core-fsadapter)' },
  { comment: true, text: '[todo] Add board hot-reload (add-board-hot-reload)' },
];

const traceRecordSnippet = [
  { prompt: '›', text: 'shipbench task comment build-core-fsadapter --body-file decision.md' },
  { comment: true, text: 'Added update to build-core-fsadapter' },
  {},
  { comment: true, text: '# .shipbench/tasks/build-core-fsadapter.md' },
  { text: '## Task Updates' },
  {},
  { text: '### 2026-07-22T17:18:00.000Z' },
  { text: 'Put fs calls behind a StorageAdapter so the board can run on GitHub too.' },
];

const traceRetrieveSnippet = [
  { prompt: '›', text: 'shipbench task search "StorageAdapter" --all' },
  { comment: true, text: 'Build core FsAdapter (build-core-fsadapter) [live · done] [updates]' },
  { comment: true, text: '  ↳ update 0 (2026-07-22T17:18:00.000Z): Put fs calls behind a StorageAdapter so the board can run on GitHub too.' },
];

const boardUrl = `${SITE_CONFIG.githubUrl}/tree/main/.shipbench`;
---

<BaseLayout
  title={SITE_CONFIG.title}
  description={SITE_CONFIG.description}
>
  <Header />

  {/* tabindex="-1" is what makes the skip link actually move focus. Fragment
      navigation alone only sets the sequential-focus starting point, so
      document.activeElement stays on <body> and a screen reader is not taken
      anywhere. Not keyboard-reachable — -1 keeps it out of the tab order. */}
  <main id="main-content" tabindex="-1">
    <!-- Hero Section -->
    <section class="hero page-width">
      <span class="hero-badge">Plans that ship with the work</span>
      {/* Deliberately not a file-placement claim. Where the files sit is the
          mechanism, and the page gives it a whole section two scrolls down; the
          h1's job is the consequence a visitor would notice missing. The second
          clause is the half a generic task board cannot say. "Each", not
          "every": plans are per repository, and nothing on this page offers a
          view across all of them. */}
      <h1>Know where each project stands. <span>And why it got there.</span></h1>
      {/* No problem clause here on purpose (AGENTS.md › Naming and branding).
          The h1 has already made the claim, and the why-section is the very
          next thing on the page — a compressed version of its argument in the
          subhead only restates it two scroll-lengths early. */}
      <p class="subhead">
        ShipBench keeps the plan in your repository as Markdown, with room on each task for the reason behind it, so six weeks from now you can look up what's next and why you chose it.
      </p>

      <div class="hero-cta">
        <a class="button primary" href="#start">Get Started</a>
        <a class="button" href="/docs/overview/">Read the Docs</a>
        <a class="button" href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener">View on GitHub</a>
      </div>

      <!-- Integrated Hero Workspace Preview -->
      <HeroWorkspaceWindow />
    </section>

    {/* Deliberately the one section on the page that is prose rather than a
        container. Everything around it — the hero window, the fact strip, the
        decision trace, the quickstart terminal — is a box, and boxes get
        scanned. This is the only section that has to be read sentence by
        sentence, and its argument runs on connective tissue that splitting into
        columns would throw away. Placement is load-bearing too: after the hero
        it motivates every section below it, and anywhere later it is a box the
        reader has no reason to stop at. */}
    <section class="section-padding page-width why-shipbench">
      <div class="section-head">
        <div class="section-badge">Why ShipBench</div>
        <h2>Working solo doesn't mean working small anymore.</h2>
      </div>

      <div class="why-prose">
        <p>
          A developer working alone with AI now keeps several workstreams moving at once, often across more than one repository. The output scaled. The tools for tracking it didn't.
        </p>
        {/* Both halves name a mechanism rather than pass a verdict, per
            AGENTS.md › the problem statement. The todo-list half used to say
            such lists "hold no state", which is plainly untrue — a checked box
            is state. The angle here is what a reader meets coming back to the
            list; the README, spec, and why page each take a different one. */}
        <p>
          That leaves two bad fits. Hosted project tools are built to coordinate people, so most of what you configure is overhead for a team you don't have — and you configure it again with every new project. A <code>TODO.md</code> sits in the right place and takes a minute to start. Come back to it a month later and it tells you which lines are checked, but not which one is blocked, what order the rest go in, or why you wrote one of them at all.
        </p>
        <p class="why-premise">
          Your repository already holds your code, your documentation, and your architecture decisions. The plan belongs there too.
        </p>
        <p>
          So ShipBench keeps it there — Markdown tasks with real structure, versioned alongside the work they describe, readable by your editor, your terminal, and the agents already working in the repo. When you write down why you made a call, it goes in the same file, and search finds it later.
        </p>
        <p class="why-proof">
          ShipBench runs on ShipBench: this page began as a task in <a href={boardUrl} target="_blank" rel="noopener">the repository that builds it</a>.
        </p>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="section-padding page-width how-it-works">
      <div class="section-head">
        <div class="section-badge">How It Works</div>
        <h2>Your project plan stays part of the project.</h2>
        <p>
          ShipBench adds a small, self-contained project system to any Git repository.
        </p>
      </div>

      <div class="system-facts">
        <article class="system-fact">
          <span class="system-fact-label">Storage</span>
          <h3>Lives in the repository</h3>
          <p><code>.shipbench/</code> keeps tasks, configuration, layout, and project guidance beside your code.</p>
        </article>

        <article class="system-fact">
          <span class="system-fact-label">Structure</span>
          <h3>Structured enough to query</h3>
          <p>Each task pairs Markdown prose with YAML metadata — status, priority, dependencies, timestamps — so the CLI can rank what is ready and refuse an invalid write.</p>
        </article>

        <article class="system-fact">
          <span class="system-fact-label">Durability</span>
          <h3>Carried by Git</h3>
          <p>Commits record the history, branches carry planning changes, and every clone remains usable without a hosted service.</p>
        </article>
      </div>
    </section>

    {/* The page's one demonstration. It replaced a three-card feature grid that
        listed the editor, the board, and the CLI as interchangeable surfaces —
        true, and it argued nothing. The same three surfaces are still here; they
        are now the places one task passes through.

        The task is the spine on purpose. An earlier draft framed this as a
        decision followed through time, which made the page's most memorable
        block read as a decision log with a board attached — the inverse of what
        ShipBench is. Same three steps, same evidence; the task carries them, and
        the reasoning is what it accumulates along the way.

        The page says capture is manual once, in step 02, where it happens.
        Saying it again in the intro and the why-section read as hedging. */}
    <section class="section-padding page-width">
      <div class="section-head">
        <div class="section-badge">One Task, Followed Through</div>
        <h2>One task, from picked up to explained months later.</h2>
        <p>
          Three commands, one task file. The same task tells you what to work on, holds the explanation while you work, and answers the question when you come back.
        </p>
      </div>

      <div class="decision-trace">
        <article class="trace-step">
          <div class="trace-step-head">
            <span class="trace-step-index">01</span>
            <span class="trace-step-surface">ShipBench CLI</span>
          </div>
          <h3>Pick up what is actually ready</h3>
          <p>
            <code>--available</code> lists the default column's tasks whose dependencies are all finished, ranked by priority and then age. This is the everyday loop — the same question the local board answers visually, asked from a terminal or by an agent instead.
          </p>
          <CodeBlock
            class="trace-code"
            scrollable
            copyable={false}
            label="Listing available ShipBench tasks"
            lines={traceSelectSnippet}
          />
        </article>

        <article class="trace-step">
          <div class="trace-step-head">
            <span class="trace-step-index">02</span>
            <span class="trace-step-surface">The task file</span>
          </div>
          <h3>Record the decision where the work is</h3>
          <p>
            One command appends a timestamped entry to the same Markdown file your editor opens and the board renders. You write it, or you ask your agent to — the capture step is deliberate.
          </p>
          <CodeBlock
            class="trace-code"
            scrollable
            copyable={false}
            label="Recording a decision as a ShipBench task update"
            lines={traceRecordSnippet}
          />
        </article>

        <article class="trace-step">
          <div class="trace-step-head">
            <span class="trace-step-index">03</span>
            <span class="trace-step-surface">ShipBench CLI</span>
          </div>
          <h3>Find it again months later</h3>
          <p>
            Search covers titles, tags, descriptions, and Task Updates, live and archived, and reports which of them matched. You get the entry back as written, with its date and the task it belongs to.
          </p>
          <CodeBlock
            class="trace-code"
            scrollable
            copyable={false}
            label="Searching ShipBench tasks and updates for a recorded decision"
            lines={traceRetrieveSnippet}
          />
        </article>
      </div>

      <p class="trace-note">
        None of this belongs to the terminal. <code>shipbench board</code> renders the same files as a live Kanban view — drag a card and the Markdown changes, edit the Markdown and the board follows — and your editor opens them directly. There is one copy on disk, so switching between the three surfaces needs no syncing.
      </p>
    </section>

    <!-- Quickstart Section -->
    <section class="section-padding page-width" id="start">
      <div class="section-head">
        <div class="section-badge">Quickstart</div>
        <h2>Three commands to make any repository a ShipBench project.</h2>
        <p>Initialize ShipBench, create the first task, and open the local board—no account or API key required.</p>
      </div>

      <div class="quickstart-box">
        <div class="quickstart-head">
          <span>SHIPBENCH CLI QUICKSTART</span>
          <span>~/code/my-project</span>
        </div>
        {/* Copyable, unlike the specimens in the hero and the decision trace.
            These are the three real commands the section's heading promises,
            and they are the most copy-worthy strings on the page.
            `code-copy.ts` strips the `.comment` captions and the `.prompt`
            glyphs, so the clipboard gets the three `npx shipbench ...` commands
            and nothing to clean up - blank lines and all, since only
            consecutive blanks collapse. The old `copyable={false}` grouped this
            with the hero mockups as "illustrative", which these commands never
            were. */}
        <CodeBlock
          class="quickstart-code"
          label="ShipBench CLI quickstart"
          lines={quickstartSnippet}
        />
      </div>
      <a class="quickstart-more-link" href="/docs/quickstart/">Full quickstart guide &rarr;</a>
    </section>

    {/* Harbor Teaser Section. The whole block goes when Harbor is not live,
        button and copy together: a section that describes a hosted client and
        then declines to link to it is a worse answer than silence, and the page
        ends on the quickstart either way. The .harbor-banner rules stay in
        landing.css — this is a flag, not a removal. */}
    {SITE_CONFIG.harborEnabled && (
      <section class="section-padding page-width">
        <div class="harbor-banner">
          <div class="harbor-info">
            <div class="section-badge" style="color: var(--accent);">ShipBench Harbor</div>
            <h2>Shape ideas before a repository exists. View projects after it does.</h2>
            <p>
              ShipBench Harbor is the optional hosted client. Capture and organize ideas, then view public GitHub-backed project boards in read-only mode. Every ShipBench task stays in its repository.
            </p>
          </div>
          <a class="button primary" href={SITE_CONFIG.harborUrl} target="_blank" rel="noopener">Open ShipBench Harbor</a>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>
