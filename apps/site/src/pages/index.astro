---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroLanes from '../components/HeroLanes.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { SITE_CONFIG } from '../config/site';

const quickstartSnippet = [
  { comment: true, text: '# 1. Initialize ShipBench' },
  { prompt: '›', text: 'npx shipbench init' },
  {},
  { comment: true, text: '# 2. Create the first task' },
  { prompt: '›', text: 'npx shipbench task create "Build landing page" --priority=high' },
  {},
  { comment: true, text: '# 3. Open the local board' },
  { prompt: '›', text: 'npx shipbench board' },
];

const parts = [
  {
    title: 'A folder in the repository',
    detail: '.shipbench/',
    body: '`shipbench init` adds a folder with a config file, a README, and instructions for agents. It gets committed with everything else.',
  },
  {
    title: 'One file per task',
    detail: 'tasks/write-the-docs.md',
    body: 'Each task is a Markdown file. The frontmatter holds status, priority, tags, and dependencies. The body holds whatever the task needs: notes, links to other tasks, dated updates.',
  },
  {
    title: 'Tools that read the files',
    detail: 'shipbench board',
    body: 'The CLI creates, moves, searches, and checks tasks. The board shows them as columns in your browser or your terminal. Editing a file by hand works too.',
  },
];

const uses = [
  {
    title: 'Small side projects',
    detail: 'shipbench init',
    body: 'Run it next to `git init` and the project has a board. There is nothing to sign up for, so a weekend project can have one too.',
    href: '/docs/quickstart/',
  },
  {
    title: 'Larger software projects',
    detail: 'task list --available',
    body: 'Priorities, dependencies, and your own columns. The CLI lists what is ready to start and rejects a status or priority your config does not define.',
    href: '/docs/cli-reference/#shipbench-task-list',
  },
  {
    title: 'A board in the browser',
    detail: 'shipbench board',
    body: 'A local Kanban board over the same files. Drag a card and the file changes. Change the file and the board updates.',
    href: '/docs/cli-reference/#shipbench-board-web',
  },
  {
    title: 'A board in the terminal',
    detail: 'shipbench board terminal',
    body: 'A live, read-only board in a terminal pane, next to your editor or an agent session.',
    href: '/docs/cli-reference/#shipbench-board-terminal',
  },
  {
    title: 'Working with agents',
    detail: '.shipbench/AGENTS.md',
    body: 'Agents get instructions for the task format and the CLI, then create, move, and comment on tasks the way you do. Nothing requires them.',
    href: '/docs/quickstart/#work-with-a-coding-agent',
  },
  {
    title: 'Finding out why',
    detail: 'task search',
    body: 'Tasks link to each other and collect dated updates. Later, search finds them and an agent can follow the links back through the work. It finds what someone wrote down, nothing more.',
    href: '/docs/convention-spec/#task-updates',
  },
  {
    title: 'More than code',
    detail: 'status: draft',
    body: 'A task is Markdown, so the same setup tracks drafts, posts, or anything else that moves through states. Name the columns whatever fits.',
    href: '/docs/why/#not-only-code',
  },
  {
    title: 'Your own process',
    detail: '.shipbench/config.json',
    body: 'ShipBench fixes the file format, not the workflow. The docs show review gates, worktrees for parallel agents, and working straight on main.',
    href: '/docs/workflows/',
  },
];

const withCode = (text: string) =>
  text.replace(/`([^`]+)`/g, (_, code) => `<code>${code}</code>`);
---

<BaseLayout
  title={SITE_CONFIG.title}
  description={SITE_CONFIG.description}
>
  <Header />

  {/* tabindex="-1" lets the skip link move focus to <main>, not just scroll. */}
  <main id="main-content" tabindex="-1">
    <section class="hero page-width">
      <div class="hero-copy">
        <h1>Plans that ship with the work.</h1>
        <p class="hero-lead">
          ShipBench keeps each task as a Markdown file in the repository it belongs to. The CLI, a local board, your editor, and your agents all work from those files.
        </p>
        <p class="hero-note">One command to set up. No account, nothing to host.</p>
        <div class="hero-cta">
          <a class="button primary" href="#start">Get started</a>
          <a class="button" href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>
      <div class="hero-visual">
        <HeroLanes />
      </div>
    </section>

    <section class="band page-width" aria-labelledby="how-heading">
      <h2 id="how-heading">How it works</h2>
      <div class="band-body parts">
        {parts.map(part => (
          <article class="part">
            <h3>{part.title}</h3>
            <p set:html={withCode(part.body)} />
            <code class="detail">{part.detail}</code>
          </article>
        ))}
      </div>
    </section>

    <section class="band page-width" aria-labelledby="uses-heading">
      <h2 id="uses-heading">Ways to use it</h2>
      <div class="band-body uses">
        {uses.map(use => (
          <a class="use" href={use.href}>
            <h3>{use.title}</h3>
            <p set:html={withCode(use.body)} />
            <code class="detail">{use.detail}</code>
          </a>
        ))}
      </div>
    </section>

    <section class="band page-width" aria-labelledby="why-heading">
      <h2 id="why-heading">Why it exists</h2>
      <div class="band-body why">
        <p>
          ShipBench started as one developer's way of keeping track of several AI-assisted projects at once. A hosted tracker meant setting up a new project for every repository, plus an integration so agents could reach it, and most of what it offered was built for teams. Notes kept in the repository solved the access problem, but a list had no room for a task's context, and a spec document grew until nobody read it.
        </p>
        <p>
          A file per task sits between the two. It's quick to start in any project, structured enough for tools to check, and it gives each task's notes a place of their own.
        </p>
        <a class="text-link" href="/docs/why/">Read the longer version</a>
      </div>
    </section>

    <section class="band page-width" id="start" aria-labelledby="start-heading">
      <h2 id="start-heading">Try it in a repository</h2>
      <div class="band-body start">
        <p>Run these in any Git repository. They set up ShipBench, add a first task, and open the board.</p>
        <CodeBlock
          class="quickstart-code"
          label="ShipBench CLI quickstart"
          lines={quickstartSnippet}
          scrollable
        />
        <a class="text-link" href="/docs/quickstart/">Full quickstart guide</a>
      </div>
    </section>

    {SITE_CONFIG.harborEnabled && (
      <section class="band page-width" aria-labelledby="harbor-heading">
        <h2 id="harbor-heading">ShipBench Harbor</h2>
        <div class="band-body harbor">
          <p>
            ShipBench Harbor is the optional hosted client. Capture and organize ideas, then view public GitHub-backed project boards in read-only mode. Every ShipBench task stays in its repository.
          </p>
          <a class="button primary" href={SITE_CONFIG.harborUrl} target="_blank" rel="noopener">Open ShipBench Harbor</a>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>
