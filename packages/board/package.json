{
  "name": "@shipbench/board",
  "version": "0.5.0",
  "description": "React kanban board for ShipBench. Published so the CLI and out-of-repo hosts can consume it; not a supported standalone library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmmurray/shipbench.git",
    "directory": "packages/board"
  },
  "homepage": "https://shipbench.dev",
  "bugs": {
    "url": "https://github.com/gmmurray/shipbench/issues"
  },
  "keywords": [
    "shipbench",
    "kanban",
    "board",
    "react",
    "project-management"
  ],
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json",
      "./dist/*": "./dist/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs && tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.demo.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/intel-one-mono": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@shipbench/core": "workspace:*",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4.3.2",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
