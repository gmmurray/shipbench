{
  "name": "@shipbench/core",
  "version": "0.7.1",
  "description": "Headless library for the ShipBench project convention — parse, validate, and write Markdown task files through a pluggable storage adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmmurray/shipbench.git",
    "directory": "packages/core"
  },
  "homepage": "https://shipbench.dev",
  "bugs": {
    "url": "https://github.com/gmmurray/shipbench/issues"
  },
  "keywords": [
    "shipbench",
    "project-management",
    "tasks",
    "kanban",
    "markdown",
    "frontmatter",
    "git",
    "agents"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./layout": {
      "types": "./src/layout.ts",
      "import": "./src/layout.ts"
    },
    "./search": {
      "types": "./src/search.ts",
      "import": "./src/search.ts"
    },
    "./flag": {
      "types": "./src/flag.ts",
      "import": "./src/flag.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./layout": {
        "types": "./dist/layout.d.ts",
        "import": "./dist/layout.js"
      },
      "./search": {
        "types": "./dist/search.d.ts",
        "import": "./dist/search.js"
      },
      "./flag": {
        "types": "./dist/flag.d.ts",
        "import": "./dist/flag.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/layout.ts src/search.ts src/flag.ts --format esm --dts",
    "dev": "tsup src/index.ts src/layout.ts src/search.ts src/flag.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
